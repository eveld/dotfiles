#!/bin/sh
set -eu

# Bootstrap dispatcher - uses chezmoi OS detection to call appropriate script
echo "Starting bootstrap process..."

{{ if eq .chezmoi.os "darwin" }}
exec "$(dirname "$0")/scripts/bootstrap_darwin.sh"
{{ else if eq .chezmoi.os "linux" }}
{{ if .chezmoi.osRelease }}
{{ if eq .chezmoi.osRelease.id "arch" }}
exec "$(dirname "$0")/scripts/bootstrap_arch.sh"
{{ else if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") }}
exec "$(dirname "$0")/scripts/bootstrap_debian.sh"
{{ else }}
echo "Error: Unsupported Linux distribution: {{ .chezmoi.osRelease.id }}"
exit 1
{{ end }}
{{ else }}
echo "Error: Cannot detect Linux distribution"
exit 1
{{ end }}
{{ else }}
echo "Error: Unsupported operating system: {{ .chezmoi.os }}"
exit 1
{{ end }}