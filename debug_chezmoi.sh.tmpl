#!/bin/sh
echo "=== DEBUG: Chezmoi OS Detection ==="
echo "OS: {{ .chezmoi.os }}"
echo "Arch: {{ .chezmoi.arch }}"
{{ if .chezmoi.osRelease -}}
echo "OS Release ID: {{ .chezmoi.osRelease.id | default "unknown" }}"
echo "OS Release Name: {{ .chezmoi.osRelease.name | default "unknown" }}"
{{ else -}}
echo "OS Release: not available"
{{ end -}}
echo "=================================="