#!/bin/sh
set -eu

# Packages dispatcher - uses chezmoi OS detection to call appropriate script
echo "Starting package installation..."

{{ if eq .chezmoi.os "darwin" }}
exec "{{ .chezmoi.homeDir }}/.local/share/chezmoi/scripts/packages_darwin.sh"
{{ else if eq .chezmoi.os "linux" }}
{{ if .chezmoi.osRelease }}
{{ if eq .chezmoi.osRelease.id "arch" }}
exec "{{ .chezmoi.homeDir }}/.local/share/chezmoi/scripts/packages_arch.sh"
{{ else if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") }}
exec "{{ .chezmoi.homeDir }}/.local/share/chezmoi/scripts/packages_debian.sh"
{{ else }}
echo "Error: Unsupported Linux distribution: {{ .chezmoi.osRelease.id }}"
exit 1
{{ end }}
{{ else }}
echo "Error: Cannot detect Linux distribution"
exit 1
{{ end }}
{{ else }}
echo "Error: Unsupported operating system: {{ .chezmoi.os }}"
exit 1
{{ end }}