# Ignore OS-specific scripts based on current OS and distro

{{ if ne .chezmoi.os "darwin" }}
# Not macOS - ignore darwin scripts
run_once_*_darwin.sh
{{ end }}

{{ if eq .chezmoi.os "linux" }}
# Linux - only include scripts for current distro
{{   if (.chezmoi.osRelease | and (hasKey .chezmoi.osRelease "id")) }}
{{     if ne .chezmoi.osRelease.id "arch" }}
run_once_*_arch.sh
{{     end }}
{{     if and (ne .chezmoi.osRelease.id "debian") (ne .chezmoi.osRelease.id "ubuntu") }}
run_once_*_debian.sh
{{     end }}
{{   else }}
# Unknown Linux distro - ignore all distro-specific scripts
run_once_*_arch.sh
run_once_*_debian.sh
{{   end }}
{{ else }}
# Not Linux - ignore all Linux distro scripts  
run_once_*_arch.sh
run_once_*_debian.sh
{{ end }}